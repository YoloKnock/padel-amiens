# ============================================
# Supabase — Base de données + Auth
# ============================================
# Créer un projet sur https://app.supabase.com puis aller dans Settings > API
# pour récupérer ces valeurs.

# URL publique du projet (visible côté client - OK)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co

# Clé anonyme — lecture publique (visible côté client - OK)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ⚠️ Clé service role — accès complet en écriture (UNIQUEMENT côté serveur)
# Ne JAMAIS l'exposer côté client. Sert pour le scraper qui upsert en DB.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# Cron Vercel — Authentification du scraper
# ============================================
# Token secret pour authentifier les requêtes du cron Vercel.
# Génère-le avec : openssl rand -hex 32
CRON_SECRET=remplace-moi-par-un-token-aleatoire-de-32-caracteres-minimum

# ============================================
# Back-office admin (saisie events Americano)
# ============================================
# Liste blanche des emails autorisés à se connecter au back-office /admin.
# Séparer par virgule si plusieurs administrateurs.
# Seuls ces emails pourront recevoir un Magic Link et accéder au CRUD events.
ADMIN_EMAILS=mhugopetit@gmail.com

# ============================================
# Resend — Envoi d'emails transactionnels (optionnel)
# ============================================
# Utilisé pour notifier un annonceur quand quelqu'un répond à son annonce
# matchmaking. Sans ces vars, l'app fonctionne mais les emails ne partent
# pas (l'utilisateur tombe sur le fallback mailto:).
#
# Setup :
#   1. Créer un compte sur resend.com (gratuit jusqu'à 100 mails/jour)
#   2. Vérifier le domaine padel-amiens.fr OU utiliser onboarding@resend.dev
#      pour les tests
#   3. Générer une API key (resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_FROM_EMAIL=Padel Amiens <contact@padel-amiens.fr>

# ============================================
# Optionnel — Analytics & monitoring
# ============================================
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
